{
  "$schema": "https://getcomposer.org/schema.json",
  "name": "alien1225/basisu",
  "type": "php-ext",
  "license": "MIT",
  "require": {
    "php": "^8.1 || ^8.2 || ^8.3 || ^8.4 || ^8.5"
  },
  "php-ext": {
    "build-path": "pie",
    "extension-name": "basisu",
    "support-nts": true,
    "support-zts": true,
    "download-url-method": [
      "pre-packaged-binary",
      "composer-default"
    ],
    "configure-options": [
      {
        "name": "debug",
        "description": "Build in debug mode",
        "needs-value": false
      }
    ]
  }
}
